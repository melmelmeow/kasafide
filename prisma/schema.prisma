datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  buyer
  seller
  admin
  super_admin
  superadmin
  super_duper_admin
}

enum VerificationStatus {
  unverified
  pending
  reverification
  verified
  rejected
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  confirmed
}

enum RefundStatus {
  none
  requested
  processing
  completed
  rejected
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String?   @default("buyer")
  accounts      Account[]
  sessions      Session[]
  profile       Profile?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Profile {
  id                         String    @id @default(uuid())
  email                      String?   @unique
  fullName                   String?   @map("full_name")
  firstName                  String?   @map("first_name")
  lastName                   String?   @map("last_name")
  phone                      String?
  role                       String    @default("buyer")
  accountStatus              String?   @default("unverified") @map("account_status")
  isKycVerified              Boolean?  @default(false) @map("is_kyc_verified")
  avatarUrl                  String?   @map("avatar_url")
  verifiedAt                 DateTime? @map("verified_at")
  verificationExpiry         DateTime? @map("verification_expiry")
  verificationRejectReason   String?   @map("verification_reject_reason")
  submittedVerificationAt    DateTime? @map("submitted_verification_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @default(now()) @updatedAt @map("updated_at")

  user                       User?     @relation(fields: [id], references: [id], onDelete: Cascade)
  properties                 Property[]
  payments                   Payment[]
  savedProperties            SavedProperty[]

  @@map("profiles")
}

model Barangay {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  properties Property[]

  @@map("barangays")
}

model Property {
  id                 String    @id @default(uuid())
  landownerId        String    @map("landowner_id")
  title              String
  description        String?
  price              Decimal   @db.Decimal(14, 2)
  listingType        String    @default("sale") @map("listing_type")
  propertyType       String?   @map("property_type")
  status             String    @default("draft")
  lifecycleStatus    String?   @map("lifecycle_status")
  address            String?
  barangayId         Int?      @map("barangay_id")
  images             String[]
  thumbnailUrl       String?   @map("thumbnail_url")
  bedrooms           Int?
  bathrooms          Int?
  floorAreaSqm       Decimal?  @map("floor_area_sqm") @db.Decimal(10, 2)
  lotAreaSqm         Decimal?  @map("lot_area_sqm") @db.Decimal(10, 2)
  featured           Boolean   @default(false)
  hasMultipleUnits   Boolean   @default(false) @map("has_multiple_units")
  availableUnits     Int?      @map("available_units")
  totalUnits         Int?      @map("total_units")
  rejectionReason    String?   @map("rejection_reason")
  createdAt          DateTime  @default(now()) @map("created_at")

  landowner          Profile   @relation(fields: [landownerId], references: [id], onDelete: Cascade)
  barangay           Barangay? @relation(fields: [barangayId], references: [id])
  payments           Payment[]
  savedBy            SavedProperty[]

  @@map("properties")
}

model Payment {
  id                 String    @id @default(uuid())
  propertyId         String?   @map("property_id")
  buyerId            String?   @map("buyer_id")
  userId             String?   @map("user_id")
  amount             Decimal   @db.Decimal(12, 2)
  paymentMethod      String?   @default("QR_PH") @map("payment_method")
  method             String?   @default("qr")
  purpose            String?
  period             String?
  dueDate            DateTime? @map("due_date")
  depositMonths      Int?      @map("deposit_months")
  xenditReferenceId  String?   @unique @map("xendit_reference_id")
  xenditChargeId     String?   @unique @map("xendit_charge_id")
  xenditQrString     String?   @map("xendit_qr_string")
  qrCodeUrl          String?   @map("qr_code_url")
  status             String    @default("pending")
  paidAt             DateTime? @map("paid_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime? @updatedAt @map("updated_at")

  property           Property? @relation(fields: [propertyId], references: [id])
  buyer              Profile?  @relation(fields: [buyerId], references: [id])

  @@map("payments")
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  propertyId String   @map("property_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("saved_properties")
}
